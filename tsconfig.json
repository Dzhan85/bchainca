{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2017",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "skipLibCheck": true
  },
  "exclude": [
    "src/app/transactions",
    "src/app/batches",
    "src/app/blocks",
    "src/app/states",
    "src/app/explorer",
    "src/app/entities",
    "src/app/data-table",
    "src/app/dynamic-views",
    "src/app/pipes"
  ]
}
